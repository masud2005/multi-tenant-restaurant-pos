model Customer {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  phone         String
  email         String?
  address       String?   @default("")
  loyaltyPoints Int       @default(0)
  totalSpent    Float     @default(0.0)
  tierId        String?
  notes         String?   @default("")
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier                LoyaltyTier?         @relation(fields: [tierId], references: [id], onDelete: SetNull)
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("customers")
}

model LoyaltyTransaction {
  id           String                 @id @default(uuid())
  tenantId     String
  customerId   String
  orderId      String?
  points       Int
  type         LoyaltyTransactionType @default(EARNED)
  reason       String?                @default("")
  balanceAfter Int?
  createdAt    DateTime               @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@index([orderId])
  @@map("loyalty_transactions")
}

model LoyaltySettings {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  isEnabled           Boolean  @default(true)
  spendAmountPerPoint Float    @default(100.0) // প্রতি কত টাকা খরচে ১ পয়েন্ট
  pointValue          Float    @default(1.0) // ১ পয়েন্ট রিডিম করলে কত টাকা ছাড়
  minPointsToRedeem   Int      @default(10) // রিডিম করার জন্য ন্যূনতম পয়েন্ট
  maxPointsPerOrder   Int? // প্রতি অর্ডারে সর্বোচ্চ পয়েন্ট ব্যবহারের সীমা
  expireAfterDays     Int? // পয়েন্টের মেয়াদ (দিন হিসেবে)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("loyalty_settings")
}

model LoyaltyTier {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  minSpend        Float     @default(0.0) // এই Tier অর্জনের জন্য ন্যূনতম মোট খরচ (Threshold)
  minPoints       Int       @default(0) // বা ন্যূনতম পয়েন্ট (Threshold)
  pointMultiplier Float     @default(1.0) // পয়েন্ট উপার্জনের গুণক (যেমন: 1.0x, 1.25x, 1.5x)
  discountPercent Float     @default(0.0) // এই Tier-এর গ্রাহকের জন্য অতিরিক্ত শতকরা ছাড় (%)
  description     String?   @default("")
  color           String?   @default("#3B82F6")
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@index([tenantId])
  @@index([tenantId, isDeleted])
  @@map("loyalty_tiers")
}
